{
  "name": "@snoozepal-dsh/narcolepsy-workbench",
  "version": "0.1.0",
  "description": "本机优先的发作性睡病嗜睡发作时段日志、ESS 量表序列、夜间睡眠事件、管制药耐受与就诊准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "docs/screenshots",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node --check lib/layout.js && node scripts/build-version.mjs --check && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-readme-assets.mjs . && node --test test/*.test.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-host-contract.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "check:readme": "node scripts/check-readme-assets.mjs .",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run test && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "fetch:trials": "node scripts/fetch-narcolepsy-trials-2026.mjs",
    "probe:proto": "node scripts/probe-prototype.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/narcolepsy-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
